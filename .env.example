# Copy to .env.local for local development, and add the same values in
# Netlify: Site configuration -> Environment variables.
# Never commit real values. .env.local is git-ignored.

# Public URL of the site (used for social sharing previews).
SITE_URL=https://hamzury.com

# Supabase: Project settings -> API.
# Without these, local dev saves enquiries to .data/enquiries.jsonl and production refuses enquiries.
SUPABASE_URL=
# Secret. Server-only. Never expose in the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: email the team about each new enquiry via Resend (resend.com).
RESEND_API_KEY=
# Comma-separated list of team addresses.
ENQUIRY_NOTIFY_EMAIL=
# Sender on a domain verified in Resend, e.g. "Hamzury Website <website@hamzury.com>".
ENQUIRY_FROM_EMAIL=
